---
import { url } from "../base.ts";
import Layout from '../layouts/Layout.astro';
import PhoneMock from '../components/PhoneMock.astro';
import AppBadges from '../components/AppBadges.astro';
import { ADMIN_PORTAL_URL } from '../consts.ts';

const steps = [
  { n: '01', t: 'Discover gigs', d: 'Browse fresh brand campaigns near you, filtered by the niches you actually create in.' },
  { n: '02', t: 'Apply in seconds', d: 'Tap apply on open gigs, or accept invite-only campaigns sent straight to you.' },
  { n: '03', t: 'Create & post', d: 'Make the content you love on Instagram, Threads or Facebook — your style, your voice.' },
  { n: '04', t: 'Submit proof, get paid', d: 'Drop your post link, get it verified, and watch the reward land. Simple.' },
];

const features = [
  { i: 'shield', t: 'Vetted brand campaigns', d: 'Every gig is from a real brand with a real budget. No spam, no ghosting.', span: 2 },
  { i: 'link', t: 'Link IG, Threads & Facebook', d: 'Connect your accounts once and apply with your real reach.' },
  { i: 'coins', t: 'Transparent rewards', d: 'See the payout before you apply. What you see is what you earn.' },
  { i: 'bell', t: 'Invite-only gigs', d: 'Get hand-picked for exclusive campaigns brands send just to you.' },
  { i: 'chart', t: 'Track everything', d: 'Applications, vetting, proofs and payouts — all in one tidy place.', span: 2 },
];

const niches = [
  { t: 'Beauty', img: '/img/cat-beauty.jpg' },
  { t: 'Food & Drink', img: '/img/cat-food.jpg' },
  { t: 'Fashion', img: '/img/cat-fashion.jpg' },
  { t: 'Fitness', img: '/img/cat-fitness.jpg' },
];

const faqs = [
  { q: 'Is Creators Sphere free to join?', a: 'Yes — creating an account and browsing campaigns is completely free. You only ever earn; we never charge creators to apply.' },
  { q: 'How much can I earn?', a: 'Every campaign shows its reward up front, before you apply. Payouts depend on the brand, the deliverable and your reach — you always see the number first.' },
  { q: 'Which platforms can I link?', a: 'Instagram, Threads and Facebook. Link your accounts once and apply to campaigns with your real audience.' },
  { q: 'Where is it available?', a: 'Creators Sphere is launching in Singapore first, with fresh local brand campaigns added regularly.' },
  { q: 'How do I get paid?', a: 'Once you submit your post link and the brand verifies your proof, your reward is confirmed in-app and paid out per the campaign terms.' },
  { q: 'What is content vetting?', a: 'Some campaigns ask you to upload your content for a quick brand check before you post. It keeps both sides aligned and protects your reward.' },
];

function icon(name: string) {
  const p: Record<string, string> = {
    shield: '<path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
    link: '<path d="M9 15l6-6"/><path d="M11 6l1-1a4 4 0 0 1 6 6l-1 1"/><path d="M13 18l-1 1a4 4 0 0 1-6-6l1-1"/>',
    coins: '<ellipse cx="9" cy="7" rx="6" ry="3"/><path d="M3 7v5c0 1.7 2.7 3 6 3s6-1.3 6-3"/><ellipse cx="15" cy="14" rx="6" ry="3"/><path d="M9 17c0 1.7 2.7 3 6 3s6-1.3 6-3v-3"/>',
    bell: '<path d="M6 9a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6"/><path d="M10 20a2 2 0 0 0 4 0"/>',
    chart: '<path d="M4 19V5"/><path d="M4 19h16"/><rect x="7" y="11" width="3" height="5"/><rect x="12" y="7" width="3" height="9"/><rect x="17" y="13" width="3" height="3"/>',
  };
  return p[name] ?? '';
}
---
<Layout>
  <!-- ════════════════ HERO ════════════════ -->
  <section class="hero">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="wrap wrap-wide hero-grid">
      <div class="hero-copy">
        <span class="eyebrow" data-reveal>● Creators Sphere · Singapore</span>
        <h1 data-reveal style="--reveal-delay:60ms">
          Your next paycheck is one <span class="grad-text">tap</span> away.
        </h1>
        <p class="lead" data-reveal style="--reveal-delay:140ms">
          Fresh brand campaigns, updated daily. Discover gigs, create what you love,
          submit proof, get paid — all from one app made for creators.
        </p>
        <div class="hero-cta" data-reveal style="--reveal-delay:220ms">
          <AppBadges />
        </div>
        <p class="hero-trust" data-reveal style="--reveal-delay:300ms">
          <span>✦ Free to join</span><span>✦ Instagram, Threads &amp; Facebook ready</span>
        </p>
      </div>

      <div class="hero-visual" data-reveal style="--reveal-delay:180ms">
        <div class="float-card fc-1"><img src={url('/img/hero-creator.jpg')} alt="A creator filming content on a phone" loading="eager" /></div>
        <PhoneMock />
        <div class="float-card fc-2"><img src={url('/img/gal-phone.jpg')} alt="An Instagram feed on a phone" loading="eager" /></div>
        <div class="payout-pill">
          <span class="po-dot"></span>
          <div><strong>+ $180 earned</strong><small>Glow Labs · just now</small></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════ NICHE MARQUEE ════════════════ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {Array.from({ length: 2 }).map(() => (
        <div class="marquee-row">
          {['Beauty', 'Food & Drink', 'Fashion', 'Fitness', 'Travel', 'Lifestyle', 'Tech', 'Wellness', 'Café Culture', 'Streetwear'].map((n) => (
            <span class="mq-item">{n}<i>✦</i></span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- ════════════════ HOW IT WORKS ════════════════ -->
  <section class="section" id="how">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <span class="eyebrow">How it works</span>
        <h2>From scroll to paid in <span class="serif-accent">four steps</span></h2>
        <p class="lead">No agencies, no back-and-forth emails. Just open gigs you can start today.</p>
      </div>
      <div class="steps">
        {steps.map((s, i) => (
          <div class="step card card-hover" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="step-n">{s.n}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════ CREATORS / FEATURES ════════════════ -->
  <section class="section creators" id="creators">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <span class="eyebrow">For Creators</span>
        <h2>Built for creators, <span class="serif-accent">not spreadsheets</span></h2>
        <p class="lead">Everything you need to find work, do the work, and get paid — without the chaos.</p>
      </div>
      <div class="bento">
        {features.map((f, i) => (
          <article class={`feat card card-hover ${f.span === 2 ? 'feat-wide' : ''}`} data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="feat-ic">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icon(f.i)} />
            </span>
            <h3>{f.t}</h3>
            <p>{f.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════ NICHE GALLERY ════════════════ -->
  <section class="section niches">
    <div class="wrap wrap-wide">
      <div class="sec-head" data-reveal>
        <span class="eyebrow">Every niche</span>
        <h2>Campaigns for whatever you <span class="serif-accent">love to make</span></h2>
      </div>
      <div class="niche-tiles">
        {niches.map((n, i) => (
          <a href={url('/#download')} class="niche-tile" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <img src={url(n.img)} alt={`${n.t} creators`} loading="lazy" />
            <span class="niche-scrim"></span>
            <span class="niche-label">{n.t}</span>
          </a>
        ))}
      </div>
      <div class="mosaic" data-reveal>
        <div class="ms ms-tall"><img src={url('/img/gal-fashion.jpg')} alt="Streetwear creator" loading="lazy" /></div>
        <div class="ms"><img src={url('/img/gal-food.jpg')} alt="Food campaign" loading="lazy" /></div>
        <div class="ms"><img src={url('/img/gal-beauty.jpg')} alt="Beauty creator" loading="lazy" /></div>
        <div class="ms ms-wide"><img src={url('/img/hero-studio.jpg')} alt="Creator studio set-up" loading="lazy" /></div>
        <div class="ms ms-tall"><img src={url('/img/gal-camera.jpg')} alt="Creator with a camera" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- ════════════════ FOR BRANDS BAND ════════════════ -->
  <section class="brands-band grain" id="brands">
    <div class="wrap wrap-wide brands-grid">
      <div class="brands-copy" data-reveal>
        <span class="eyebrow on-dark">For Brands &amp; Agencies</span>
        <h2>Run influencer campaigns that <span class="grad-text">actually convert</span></h2>
        <p>Post a campaign, invite the right creators, vet the content, and track every result — from one powerful dashboard built for marketing teams.</p>
        <ul class="brands-list">
          <li>Launch open or invite-only campaigns in minutes</li>
          <li>Discover and shortlist creators by niche &amp; reach</li>
          <li>Approve content before it goes live</li>
          <li>Measure proofs, payouts and ROI in real time</li>
        </ul>
        <div class="brands-cta">
          <a href={ADMIN_PORTAL_URL} target="_blank" rel="noopener" class="btn btn-brand btn-lg">Go to Admin Portal ↗</a>
          <a href={url('/for-brands')} class="btn btn-ghost btn-lg on-dark-ghost">See how it works</a>
        </div>
      </div>
      <div class="brands-visual" data-reveal style="--reveal-delay:120ms">
        <img src={url('/img/brands-work.jpg')} alt="A marketing team planning a campaign" loading="lazy" />
        <div class="bv-card">
          <span class="bv-chip">Live campaign</span>
          <strong>Summer Glow</strong>
          <div class="bv-row"><span>Applicants</span><b>248</b></div>
          <div class="bv-row"><span>Approved</span><b>32</b></div>
          <div class="bv-bar"><i style="width:72%"></i></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════ FAQ ════════════════ -->
  <section class="section" id="faq">
    <div class="wrap faq-wrap">
      <div class="sec-head" data-reveal>
        <span class="eyebrow">FAQ</span>
        <h2>Good questions, <span class="serif-accent">straight answers</span></h2>
      </div>
      <div class="faq-list" data-reveal>
        {faqs.map((f) => (
          <details class="faq-item">
            <summary><span>{f.q}</span><i class="faq-ic"></i></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════ FINAL CTA ════════════════ -->
  <section class="section final" id="download">
    <div class="wrap">
      <div class="final-card grain" data-reveal>
        <div class="fc-blob"></div>
        <span class="eyebrow on-dark">Get started free</span>
        <h2>Ready to get paid for what you <span class="grad-text">already do?</span></h2>
        <p>Join Creators Sphere and turn your next post into your next paycheck.</p>
        <div class="final-badges"><AppBadges onDark /></div>
        <a href={url('/for-brands')} class="final-brands">Are you a brand? Explore the campaign platform →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── HERO ── */
  .hero { position: relative; overflow: hidden; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .hero-copy h1 { font-size: var(--fs-hero); margin: 18px 0 22px; }
  .hero-copy .lead { max-width: 46ch; }
  .hero-cta { margin: 30px 0 16px; }
  .hero-trust { display: flex; flex-wrap: wrap; gap: 18px; font-size: 14px; font-weight: 700; color: var(--ink-70); }

  .blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .5; z-index: 0; pointer-events: none; }
  .blob-1 { width: 460px; height: 460px; background: radial-gradient(circle, #FFD9A8, transparent 70%); top: -160px; right: -120px; }
  .blob-2 { width: 380px; height: 380px; background: radial-gradient(circle, #FFC0AE, transparent 70%); bottom: -160px; left: -140px; opacity: .4; }

  .hero-visual { position: relative; display: grid; place-items: center; min-height: 540px; }
  .hero-visual > :global(.phone) { position: relative; z-index: 2; }
  .float-card { position: absolute; z-index: 3; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow-float); border: 5px solid #fff; }
  .float-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .fc-1 { width: 148px; height: 196px; top: 6%; left: -2%; transform: rotate(-7deg); animation: floaty 7s ease-in-out infinite; }
  .fc-2 { width: 132px; height: 176px; bottom: 4%; right: -3%; transform: rotate(6deg); animation: floaty 8s ease-in-out infinite reverse; }
  @keyframes floaty { 0%,100%{translate:0 0} 50%{translate:0 -14px} }

  .payout-pill {
    position: absolute; z-index: 4; top: 46%; right: -6%;
    display: flex; align-items: center; gap: 10px;
    background: #fff; border-radius: 16px; padding: 11px 15px; box-shadow: var(--shadow-lift);
    animation: floaty 6s ease-in-out infinite;
  }
  .payout-pill strong { font-family: var(--font-display); font-weight: 800; font-size: 14px; display: block; }
  .payout-pill small { font-size: 11px; color: var(--ink-50); }
  .po-dot { width: 34px; height: 34px; border-radius: 50%; background: var(--grad-coral); display: grid; place-items: center; flex: none; box-shadow: 0 6px 14px -4px rgba(255,82,38,.6); }
  .po-dot::after { content: "$"; color: #fff; font-family: var(--font-display); font-weight: 800; }

  /* ── MARQUEE ── */
  .marquee { background: var(--ink); color: #fff; padding: 16px 0; overflow: hidden; }
  .marquee-track { display: flex; width: max-content; animation: scroll 32s linear infinite; }
  .marquee-row { display: flex; }
  .mq-item { display: inline-flex; align-items: center; gap: 22px; font-family: var(--font-display); font-weight: 800; font-size: clamp(18px, 2.4vw, 26px); letter-spacing: -.02em; padding: 0 22px; white-space: nowrap; }
  .mq-item i { color: var(--coral); font-style: normal; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  /* ── Section heads ── */
  .sec-head { max-width: 640px; margin-bottom: clamp(2rem, 4vw, 3.2rem); }
  .sec-head h2 { font-size: var(--fs-h2); margin: 14px 0 14px; }
  .sec-head .lead { max-width: 52ch; }
  .niches .sec-head, .final .sec-head { margin-inline: 0; }

  /* ── STEPS ── */
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .step { padding: 26px 22px; }
  .step-n { font-family: var(--font-display); font-weight: 800; font-size: 15px; color: #fff; background: var(--grad-coral); width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; margin-bottom: 18px; box-shadow: var(--shadow-coral); }
  .step h3 { font-size: var(--fs-h3); margin-bottom: 8px; }
  .step p { color: var(--ink-70); font-size: 15px; }

  /* ── BENTO FEATURES ── */
  .creators { background: linear-gradient(180deg, var(--surface-2), var(--page)); }
  .bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .feat { padding: 28px 26px; }
  .feat-wide { grid-column: span 2; }
  .feat-ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--peach); color: var(--coral-deep); margin-bottom: 18px; }
  .feat h3 { font-size: var(--fs-h3); margin-bottom: 8px; }
  .feat p { color: var(--ink-70); font-size: 15px; max-width: 42ch; }

  /* ── NICHE TILES + MOSAIC ── */
  .niche-tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 14px; }
  .niche-tile { position: relative; aspect-ratio: 5/4; border-radius: var(--r-card); overflow: hidden; box-shadow: var(--shadow); }
  .niche-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--t-slow); }
  .niche-tile:hover img { transform: scale(1.06); }
  .niche-scrim { position: absolute; inset: 0; background: var(--scrim); }
  .niche-label { position: absolute; left: 16px; bottom: 14px; color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 19px; letter-spacing: -.02em; }

  .mosaic { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 150px; gap: 14px; }
  .ms { border-radius: var(--r-card); overflow: hidden; box-shadow: var(--shadow); }
  .ms img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--t-slow); }
  .ms:hover img { transform: scale(1.05); }
  .ms-tall { grid-row: span 2; }
  .ms-wide { grid-column: span 2; }

  /* ── BRANDS BAND ── */
  .brands-band { position: relative; background: var(--ink); color: #EADFD6; padding-block: clamp(4rem, 8vw, 7rem); overflow: hidden; }
  .brands-band::before { content: ""; position: absolute; inset: 0; background: radial-gradient(900px 420px at 88% 12%, rgba(124,58,237,.34), transparent 60%), radial-gradient(700px 380px at 6% 96%, rgba(255,82,38,.28), transparent 60%); }
  .brands-grid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.4rem, 5vw, 4.5rem); align-items: center; }
  .brands-copy h2 { color: #fff; font-size: var(--fs-h2); margin: 14px 0 18px; }
  .brands-copy > p { color: #C9BAAF; font-size: var(--fs-lead); max-width: 46ch; line-height: 1.65; }
  .brands-list { margin: 24px 0 30px; display: grid; gap: 12px; }
  .brands-list li { position: relative; padding-left: 30px; color: #E1D4C9; font-weight: 600; }
  .brands-list li::before { content: "✓"; position: absolute; left: 0; top: -1px; width: 21px; height: 21px; border-radius: 50%; background: var(--grad-brand); color: #fff; font-size: 12px; font-weight: 800; display: grid; place-items: center; }
  .brands-cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .on-dark-ghost { background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.2); color: #fff; }
  .on-dark-ghost:hover { background: rgba(255,255,255,.12); border-color: #fff; color: #fff; }

  .brands-visual { position: relative; }
  .brands-visual > img { width: 100%; border-radius: var(--r-xl); box-shadow: var(--shadow-float); }
  .bv-card { position: absolute; bottom: -22px; left: -22px; background: #fff; color: var(--ink); border-radius: 18px; padding: 18px 20px; width: 230px; box-shadow: var(--shadow-float); }
  .bv-chip { display: inline-block; font-size: 10px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--indigo); background: #EFEAFE; padding: 4px 10px; border-radius: 100px; margin-bottom: 10px; }
  .bv-card > strong { font-family: var(--font-display); font-size: 18px; display: block; margin-bottom: 12px; }
  .bv-row { display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-70); padding: 4px 0; }
  .bv-row b { color: var(--ink); }
  .bv-bar { height: 8px; border-radius: 100px; background: var(--hair); margin-top: 8px; overflow: hidden; }
  .bv-bar i { display: block; height: 100%; background: var(--grad-brand); border-radius: 100px; }

  /* ── FAQ ── */
  .faq-wrap { max-width: 820px; }
  .faq-list { display: grid; gap: 12px; }
  .faq-item { background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r-card); padding: 4px 22px; box-shadow: var(--shadow-sm); transition: box-shadow var(--t); }
  .faq-item[open] { box-shadow: var(--shadow); }
  .faq-item summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; cursor: pointer; font-family: var(--font-display); font-weight: 800; font-size: 17px; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-ic { position: relative; width: 18px; height: 18px; flex: none; }
  .faq-ic::before, .faq-ic::after { content: ""; position: absolute; background: var(--coral); border-radius: 2px; transition: transform var(--t); }
  .faq-ic::before { top: 8px; left: 0; width: 18px; height: 2.5px; }
  .faq-ic::after { left: 8px; top: 0; width: 2.5px; height: 18px; }
  .faq-item[open] .faq-ic::after { transform: scaleY(0); }
  .faq-item p { padding: 0 0 22px; color: var(--ink-70); max-width: 64ch; line-height: 1.7; }

  /* ── FINAL CTA ── */
  .final-card { position: relative; overflow: hidden; background: var(--ink); color: #fff; border-radius: var(--r-xl); padding: clamp(2.6rem, 6vw, 4.8rem); text-align: center; }
  .fc-blob { position: absolute; inset: 0; background: radial-gradient(700px 360px at 50% -10%, rgba(255,147,34,.4), transparent 60%), radial-gradient(500px 300px at 90% 120%, rgba(255,82,38,.35), transparent 60%); }
  .final-card > * { position: relative; }
  .final-card h2 { color: #fff; font-size: var(--fs-h1); margin: 14px auto 14px; max-width: 18ch; }
  .final-card > p { color: #D7C8BD; font-size: var(--fs-lead); max-width: 42ch; margin: 0 auto; }
  .final-badges { display: flex; justify-content: center; margin: 30px 0 18px; }
  .final-brands { display: inline-block; color: var(--gold); font-weight: 700; font-size: 15px; border-bottom: 1.5px solid transparent; transition: border-color var(--t); }
  .final-brands:hover { border-color: var(--gold); }

  /* ── RESPONSIVE ── */
  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { min-height: 480px; margin-top: 12px; }
    .brands-grid { grid-template-columns: 1fr; }
    .steps { grid-template-columns: repeat(2, 1fr); }
    .bento { grid-template-columns: repeat(2, 1fr); }
    .feat-wide { grid-column: span 2; }
  }
  @media (max-width: 640px) {
    .steps, .bento, .niche-tiles { grid-template-columns: 1fr 1fr; }
    .feat-wide { grid-column: span 2; }
    .mosaic { grid-template-columns: repeat(2, 1fr); }
    .ms-wide { grid-column: span 2; }
    .hero-trust { gap: 10px 18px; }
