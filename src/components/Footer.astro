---
import Logo from './Logo.astro';
import { ADMIN_PORTAL_URL, CONTACT_EMAIL, SOCIAL, SITE_NAME, LEGAL_LAST_UPDATED } from '../consts.ts';
const year = 2026;
const social = Object.entries(SOCIAL).filter(([, url]) => url);
---
<footer class="ft grain">
  <div class="wrap wrap-wide">
    <div class="ft-top">
      <div class="ft-brand">
        <Logo onDark />
        <p>Paid brand campaigns for creators in Singapore. Discover, create, get paid — all from one app.</p>
        <div class="ft-social">
          {social.map(([name, url]) => (
            <a href={url} target="_blank" rel="noopener" aria-label={name}>{name}</a>
          ))}
        </div>
      </div>

      <nav class="ft-col" aria-label="Product">
        <h4>Product</h4>
        <a href="/#how">How it works</a>
        <a href="/#creators">For Creators</a>
        <a href="/for-brands">For Brands</a>
        <a href={ADMIN_PORTAL_URL} target="_blank" rel="noopener">Admin Portal ↗</a>
      </nav>

      <nav class="ft-col" aria-label="Legal">
        <h4>Legal</h4>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/cookies">Cookie Notice</a>
        <a href="/account-deletion">Delete my data</a>
      </nav>

      <nav class="ft-col" aria-label="Support">
        <h4>Support</h4>
        <a href="/support">Help &amp; Contact</a>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </nav>
    </div>

    <div class="ft-bottom">
      <span>© {year} {SITE_NAME}. All rights reserved.</span>
      <span class="ft-meta">creatorssphere.sg · Updated {LEGAL_LAST_UPDATED}</span>
    </div>
  </div>
</footer>

<style>
  .ft { position: relative; background: var(--ink); color: #E9DCD2; padding-block: clamp(3.5rem, 7vw, 5.5rem) 2.5rem; overflow: hidden; }
  .ft-top {
    display: grid; gap: 2.5rem 2rem;
    grid-template-columns: 1.7fr 1fr 1fr 1fr;
    padding-bottom: 2.8rem;
    border-bottom: 1px solid rgba(255, 255, 255, .1);
  }
  .ft-brand p { margin: 18px 0 20px; color: #B7A89D; max-width: 34ch; font-size: 15px; line-height: 1.7; }
  .ft-social { display: flex; gap: 10px; flex-wrap: wrap; }
  .ft-social a {
    font-size: 12px; font-weight: 800; letter-spacing: .04em; text-transform: capitalize;
    padding: 8px 14px; border-radius: var(--r-pill);
    background: rgba(255, 255, 255, .08); color: #fff; transition: var(--t);
  }
  .ft-social a:hover { background: var(--coral); }

  .ft-col h4 { color: #fff; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; margin-bottom: 16px; }
  .ft-col a { display: block; color: #B7A89D; font-size: 15px; padding: 7px 0; transition: color var(--t); }
  .ft-col a:hover { color: var(--gold); }

  .ft-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    padding-top: 1.8rem; font-size: 13px; color: #8C7C71;
  }

  @media (max-width: 760px) {
    .ft-top { grid-template-columns: 1fr 1fr; }
    .ft-brand { grid-column: 1 / -1; }
  }
</style>
